NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string (required for DB features; API starts without it)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/appointment_booking

# JWT secret for authentication (required — use a long random string in production)
JWT_SECRET=change-me

# Mistral AI API key (optional — AI features disabled without it)
MISTRAL_API_KEY=your-api-key-here
